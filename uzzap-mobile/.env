# Supabase Configuration
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# App Configuration
APP_NAME=Uzzap
APP_VERSION=1.0.0
APP_ENV=development

# Authentication
AUTH_COOKIE_NAME=uzzap_auth
AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=lax

# SMS Gateway Configuration (for OTP)
SMS_API_KEY=your_sms_api_key
SMS_API_SECRET=your_sms_api_secret
SMS_SENDER_ID=UZZAP

# Email Configuration (for notifications)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_password
SMTP_FROM=noreply@uzzap.com

# Storage Configuration
STORAGE_BUCKET=uzzap-media
STORAGE_URL=https://your_supabase_project_url/storage/v1/object/public/uzzap-media

# WebSocket Configuration
WS_URL=wss://your_supabase_project_url/realtime/v1 